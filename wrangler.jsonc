// Cloudflare Workers (정적 자산만). `npm run build`로 만든 dist/를 그대로 올린다.
// main에 push하면 Workers Builds가 `npm run build` → `npx wrangler deploy`로 배포한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "account_id": "56033a539f721535b619282bb5a20bd2",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "blog.youngin.kim", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
